DB_USER=neocollects
DB_PASSWORD=change-me
DB_NAME=neocollects
# Used when running the API on your machine (go run ./cmd/api) against the dev database
# (docker-compose.dev.yml publishes it on 127.0.0.1:5433).
# docker-compose builds its own DATABASE_URL pointing at the "db" service.
DATABASE_URL=postgres://neocollects:change-me@127.0.0.1:5433/neocollects?sslmode=disable
HTTP_ADDR=:8090
APP_DEBUG=false
# Database used by the repository tests (they roll back, but never point this at real data).
# Create it once: docker compose exec db psql -U neocollects -c "CREATE DATABASE neocollects_test"
TEST_DATABASE_URL=postgres://neocollects:change-me@127.0.0.1:5433/neocollects_test?sslmode=disable

# --- Image storage (Garage) ---
# Generate once: GARAGE_RPC_SECRET=$(openssl rand -hex 32), S3_ACCESS_KEY=GK$(openssl rand -hex 12), S3_SECRET_KEY=$(openssl rand -hex 32)
GARAGE_RPC_SECRET=
S3_BUCKET=images
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Where the API on your machine reaches the S3 port (docker-compose.dev.yml publishes it on loopback).
S3_ENDPOINT=127.0.0.1:3900
S3_USE_SSL=false
# Where the images are read from, as the APP sees it: the "images" proxy (port 8091). Use the same host name as the app's
# NEOCOLLECTS_API_BASE_URL (your Mac's ".local" name): 127.0.0.1 only works in the simulator, a real iPhone would look for
# the images on itself.
IMAGES_BASE_URL=http://aria-2.local:8091

# --- Accounts ---
# The code a sign-up must give (the app asks for it). Empty: sign-up is closed. Make it long and random: openssl rand -base64 18
INVITE_CODE=

# --- Production (docker-compose.prod.yml; the server's Caddy, see caddy/Caddyfile, handles HTTPS) ---
# Two DNS records pointing at the server, then IMAGES_BASE_URL=https://images.example.com (above).
# Loopback ports the server's Caddy reaches: the API and the pictures.
APP_PORT=8090
IMAGES_PORT=3902
