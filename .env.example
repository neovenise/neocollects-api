# Database: one password, used by docker compose and by `go run` on your machine
# (docker-compose.dev.yml publishes the database on 127.0.0.1:5433). The URL is built from it.
# Optional: DB_USER, DB_NAME, DB_HOST (127.0.0.1), DB_PORT (5433), or a whole DATABASE_URL.
DB_PASSWORD=change-me

# Image storage (Garage). Generate once:
# GARAGE_RPC_SECRET=$(openssl rand -hex 32)  S3_ACCESS_KEY=GK$(openssl rand -hex 12)  S3_SECRET_KEY=$(openssl rand -hex 32)
GARAGE_RPC_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=127.0.0.1:3900
IMAGES_BASE_URL=INSERT_IMAGES_BASE_URL_HERE

# The code a sign-up must give. Empty: sign-up is closed. Make it long and random: openssl rand -base64 18
INVITE_CODE=welcome-to-neocollects!